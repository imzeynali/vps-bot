{
  "name": "vps-telegram-bot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "webhook": "tsx --env-file=.env.local scripts/set-webhook.ts",
    "test:virt": "tsx --env-file=.env.local test/e2e.ts",
    "virt:discover": "tsx --env-file=.env.local scripts/virt-discover.ts",
    "test:admin": "tsx --env-file=.env.local test/admin-ui.ts",
    "test:dc": "tsx --env-file=.env.local test/datacenters.ts",
    "cgi:seed": "tsx --env-file=.env.local scripts/cgi-seed.ts",
    "hc3:discover": "tsx --env-file=.env.local scripts/hc3-discover.ts",
    "cgi:regions": "tsx --env-file=.env.local scripts/cgi-regions.ts",
    "cgi:smoke": "tsx --env-file=.env.local scripts/cgi-smoke.ts",
    "test:cgimenu": "tsx --env-file=.env.local test/cgi-menu.ts",
    "test:cgi": "tsx --env-file=.env.local test/cgi.ts",
    "test": "npm run test:virt && npm run test:admin && npm run test:dc && npm run test:cgi && npm run test:cgimenu"
  },
  "dependencies": {
    "grammy": "^1.30.0",
    "next": "^15.0.0",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
