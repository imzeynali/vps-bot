# کپی کنید به .env.local
BOT_TOKEN=123456:ABC...
WEBHOOK_SECRET=یک_رشته_تصادفی_طولانی
APP_URL=https://your-domain.com
DATABASE_URL=postgresql://user:password@localhost:5432/vpsbot
ADMIN_IDS=123456789
SUPPORT_USERNAME=@your_support
CARD_NUMBER=6037-0000-0000-0000
CARD_OWNER=نام صاحب کارت
MIN_TOPUP=10000
MIN_BALANCE_TO_BUY=100000
REF_PERCENT=10
CRON_SECRET=یک_رشته_تصادفی_دیگر

# ───────── اتصال به Virtualizor (Admin API) ─────────
# Admin Panel → Configuration → API Credentials
VIRT_URL=https://panel.example.com:4085
VIRT_API_KEY=
VIRT_API_PASS=
# 1 = گواهی SSL پنل self-signed است
VIRT_INSECURE_TLS=0
VIRT_TYPE=kvm
# به‌ازای هر خرید یک کاربر اختصاصی در پنل ساخته می‌شود: <PREFIX><N>@<DOMAIN>
# N = START + شناسه سرویس − ۱ → مثلاً tetaclouduser1001@mizban.com
VIRT_USER_PREFIX=tetaclouduser
VIRT_USER_DOMAIN=mizban.com
VIRT_USER_START=1001
# الگوی hostname سرور: {n} = همان شماره ، {id} = شناسه سرویس ، {domain} = VPS_DOMAIN
VPS_HOSTNAME_TEMPLATE=tetacloud.s{n}.com
# (حالت قدیمی، فقط اگر VIRT_USER_DOMAIN خالی باشد) یک کاربر مشترک:
VIRT_OWNER_UID=
VIRT_OWNER_EMAIL=
VIRT_OWNER_PASS=
# اختیاری
VIRT_IP_POOL_ID=
VIRT_STORAGE_UUID=
# دامنه hostname سرورها (پیش‌فرض: دامنه APP_URL) → s<ID>.<دامنه>
VPS_DOMAIN=

# ───────── دیتاسنتر CGI (بین‌الملل) — HostVDS / OpenStack ─────────
# Application Credential را در Horizon بسازید: Identity ← Application Credentials (Secret فقط یک‌بار نمایش داده می‌شود)
CGI_AUTH_URL=https://os-api.hostvds.com/identity/v3
CGI_APP_CRED_ID=
CGI_APP_CRED_SECRET=
CGI_REGION=eu-north3
# نگاشت لوکیشن‌های منوی خرید به ریجن‌های HostVDS (کدها را با «npm run cgi:regions» ببینید)؛ لوکیشنِ بدون نگاشت پنهان می‌ماند
# CGI_REGION_MAP=paris=eu-west3,nl=eu-west1,lv=eu-north1b,fi=eu-north3
# گروه امنیتی با ورودی/خروجی باز (نام آن در Horizon ← Network ← Security Groups)
CGI_SECURITY_GROUP=allow_all
# اینستالر (install.sh / «vpsbot cgi») همه‌ی CGI_* و CGI_REGION_MAP را خودش می‌پرسد و می‌نویسد.
# (اختیاری) CGI_NOVA_MICROVERSION=2.79  CGI_TIMEOUT_MS=30000  CGI_BUILD_TIMEOUT_MS=240000  CGI_POLL_MS=3000

# ── 3HCloud (بین‌الملل، OpenStack) — مقادیر از فایل RC کاربر API (Control panel → Account → Access → API) ──
# اینستالر (install.sh / «vpsbot h3c») همه را می‌پرسد و می‌نویسد.
# هر ریجن Keystone جدا دارد؛ کاربر/رمز/پروژه برای همه‌ی ریجن‌ها یکی است. الگوی پیش‌فرض آدرس: https://identity.api.os.{code}.3hcloud.com
# H3C_AUTH_URL=https://identity.api.os.{code}.3hcloud.com
# H3C_AUTH_URLS=Dallas=https://identity.api.os.dfw.3hcloud.com   (اختیاری، جایگزینی دستی)
H3C_USERNAME=
H3C_PASSWORD=
H3C_PROJECT=            # OS_PROJECT_ID (۳۲ کاراکتر) یا نام پروژه
H3C_USER_DOMAIN=Default
H3C_PROJECT_DOMAIN=Default
# نگاشت لوکیشن‌ها به OS_REGION_NAME (کدها: mia dfw sfo waw ala mnl). پیش‌فرض: همه‌ی ۶ ریجن
H3C_REGION_MAP=mia=Miami,dfw=Dallas,sfo=SanFrancisco,waw=Warsaw,ala=Almaty,mnl=Manila
# ریجن پیش‌فرض برای خواندن کاتالوگ
H3C_REGION=
# (اختیاری) نام شبکه‌ی عمومی؛ خالی = شبکه‌های router:external
H3C_NETWORK=
# گروه امنیتی با ورودی/خروجی باز (در پنل Virtual firewalls بسازید)
H3C_SECURITY_GROUP=allow_all
# (اختیاری) نوع دیسک سیستم و اندازه‌ی پیش‌فرض برای فلورهای بدون دیسک
H3C_VOLUME_TYPE=
H3C_DISK_GB=40
# (اختیاری) قیمت ساعتی فلورها هنگام seed: نام=قیمت,نام=قیمت (ماهانه = ساعتی × ۷۲۰)
H3C_PRICES=
