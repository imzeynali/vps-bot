# کپی کنید به .env.local
BOT_TOKEN=123456:ABC...
WEBHOOK_SECRET=یک_رشته_تصادفی_طولانی
APP_URL=https://your-domain.com
DATABASE_URL=postgresql://user:password@localhost:5432/vpsbot
ADMIN_IDS=123456789
SUPPORT_USERNAME=@your_support
CARD_NUMBER=6037-0000-0000-0000
CARD_OWNER=نام صاحب کارت
MIN_TOPUP=10000
MIN_BALANCE_TO_BUY=100000
REF_PERCENT=10
CRON_SECRET=یک_رشته_تصادفی_دیگر

# ───────── اتصال به Virtualizor (Admin API) ─────────
# Admin Panel → Configuration → API Credentials
VIRT_URL=https://panel.example.com:4085
VIRT_API_KEY=
VIRT_API_PASS=
# 1 = گواهی SSL پنل self-signed است
VIRT_INSECURE_TLS=0
VIRT_TYPE=kvm
# به‌ازای هر خرید یک کاربر اختصاصی در پنل ساخته می‌شود: <PREFIX><N>@<DOMAIN>
# N = START + شناسه سرویس − ۱ → مثلاً tetaclouduser1001@mizban.com
VIRT_USER_PREFIX=tetaclouduser
VIRT_USER_DOMAIN=mizban.com
VIRT_USER_START=1001
# الگوی hostname سرور: {n} = همان شماره ، {id} = شناسه سرویس ، {domain} = VPS_DOMAIN
VPS_HOSTNAME_TEMPLATE=tetacloud.s{n}.com
# (حالت قدیمی، فقط اگر VIRT_USER_DOMAIN خالی باشد) یک کاربر مشترک:
VIRT_OWNER_UID=
VIRT_OWNER_EMAIL=
VIRT_OWNER_PASS=
# اختیاری
VIRT_IP_POOL_ID=
VIRT_STORAGE_UUID=
# دامنه hostname سرورها (پیش‌فرض: دامنه APP_URL) → s<ID>.<دامنه>
VPS_DOMAIN=
